# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose.yml overrides DATABASE_URL/REDIS_URL/PORT itself to point at
# the `postgres`/`redis` services it manages — the values below are only used
# when running the server/worker directly on the host (npm run dev:server /
# npm run dev:worker) against your own Postgres/Redis instances.

DATABASE_URL=postgresql://tradepal:tradepal@localhost:5432/tradepal
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API (see PHASE_0_FINDINGS.md ADR-1). WHATSAPP_ACCESS_TOKEN
# and WHATSAPP_PHONE_NUMBER_ID are required by src/worker.ts, whose entire job
# is sending replies to inbound messages. They're read optionally by
# src/server.ts and src/subscriptionExpiryWorker.ts: both still function
# without them (the admin-triggered and hourly expire-subscriptions sweeps
# still run), just skipping the Phase 7 subscription-lapse WhatsApp
# notification rather than failing to boot over an off-by-default feature.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Phase 9: optional, and only meaningful alongside the two vars above. If you've
# created and had Meta approve a WhatsApp message template for the Phase 7
# subscription-lapse notification, set both to send it as that template instead
# of Phase 7's original free-form text (templates are deliverable outside the
# merchant's 24-hour service window; free-form text is not). The template is
# assumed to have exactly one body placeholder, filled with the lapsed plan's
# code. Leave both unset to keep the free-form-text fallback.
WHATSAPP_SUBSCRIPTION_LAPSE_TEMPLATE_NAME=
WHATSAPP_SUBSCRIPTION_LAPSE_TEMPLATE_LANGUAGE=

# Phase 18: the same opt-in as the two vars above, for the Phase 12 weekly
# business digest instead of the Phase 7 lapse notification — a digest is
# also a business-initiated send that can fall outside the merchant's
# 24-hour service window. The template is assumed to have exactly 7 body
# placeholders, one per line of the free-form digest message (see
# src/domain/businessDigest.ts's buildWeeklyDigestTemplateParams). Leave both
# unset to keep the free-form-text fallback.
WHATSAPP_WEEKLY_DIGEST_TEMPLATE_NAME=
WHATSAPP_WEEKLY_DIGEST_TEMPLATE_LANGUAGE=

# Phase 20: the same opt-in as the four vars above, for the deletion-request
# resolution notice (src/domain/deletion.ts) instead of the Phase 7 lapse
# notification or Phase 12 weekly digest — resolving a merchant's data-
# deletion request is also a business-initiated send that can fall outside
# the merchant's 24-hour service window. The template is assumed to have
# exactly 2 body placeholders: {{1}} the outcome ("completed" or "not
# approved"), {{2}} the resolution note (or a fallback string when none was
# given) — see deletion.ts's buildDeletionResolutionTemplateParams. Leave
# both unset to keep the free-form-text fallback.
WHATSAPP_DELETION_RESOLUTION_TEMPLATE_NAME=
WHATSAPP_DELETION_RESOLUTION_TEMPLATE_LANGUAGE=

# Phase 21: the same opt-in as the six vars above, for the addStaffMerchant
# proactive notification (src/domain/merchantIdentity.ts) instead of the
# other three proactive sends — a newly-added staff member may not message
# the bot within 24 hours of being invited. Unlike the other three templates,
# this one needs no body placeholders (the message carries no per-invite
# dynamic data). Leave both unset to keep the free-form-text fallback.
WHATSAPP_STAFF_ADDED_TEMPLATE_NAME=
WHATSAPP_STAFF_ADDED_TEMPLATE_LANGUAGE=

# Phase 22: Flutterwave hosted checkout (see src/domain/payments.ts,
# src/flutterwave/, PHASE_0_FINDINGS.md Phase 22 section). Backs /upgrade
# (src/commands/commandRouter.ts) and the /webhooks/flutterwave route
# (src/server.ts). All four are optional together — a deployment that hasn't
# set up Flutterwave yet still boots both src/server.ts and src/worker.ts,
# just with /upgrade reporting itself unavailable and the webhook route
# unmounted, same as every other off-by-default feature in this codebase.
#
# FLUTTERWAVE_SECRET_KEY authorizes both creating a checkout link (worker) and
# verifying a transaction server-to-server (server) — one credential, like
# WHATSAPP_ACCESS_TOKEN above.
FLUTTERWAVE_SECRET_KEY=
# The static shared-secret value configured as your Flutterwave webhook's
# "secret hash" — compared against the inbound `verif-hash` header
# (src/flutterwave/signature.ts) to authenticate the webhook call itself.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Where Flutterwave's hosted checkout page redirects the merchant's browser
# after they finish paying (never itself part of the bot conversation — see
# config/paymentsEnv.ts's doc comment).
FLUTTERWAVE_CHECKOUT_REDIRECT_URL=

# Phase 22: the same template opt-in as the four WHATSAPP_*_TEMPLATE_* pairs
# above, for the payment-confirmation notification instead of lapse/digest/
# deletion/staff-added — a completed Flutterwave checkout is itself a
# business-initiated send that can fall outside the merchant's 24-hour
# service window. The template is assumed to have exactly one body
# placeholder, filled with the newly-active plan's code. Leave both unset to
# keep the free-form-text fallback.
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE_NAME=
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE_LANGUAGE=

# PawaPay mobile money aggregator — C2B collection for West Africa.
# Covers Afrimoney (Africell SL), Orange Money SL, Orange Liberia,
# Africell Gambia, and more via a single API integration.
#
# PAWAPAY_API_TOKEN: Bearer token from your PawaPay dashboard.
#   Sandbox: dashboard.pawapay.io → API Tokens → copy sandbox token
#   Production: requires KYB approval from PawaPay
#
# Sandbox callback URL (configure in PawaPay dashboard → Webhooks):
#   https://<your-hostname>/webhooks/pawapay
#
# Docs: https://docs.pawapay.io
# Test script: scripts/test-pawapay-sandbox.ts
PAWAPAY_API_TOKEN=
# Defaults to PawaPay's sandbox (https://api.sandbox.pawapay.io/v2). For production set
# https://api.pawapay.io/v2 together with a production token — mixing the two is rejected.
PAWAPAY_API_BASE_URL=

# AI parsing provider (see src/ai/provider.ts, PHASE_0_FINDINGS.md ADR-2)
ANTHROPIC_API_KEY=

# Voice-note transcription (see src/stt/provider.ts, src/worker.ts). Optional:
# leave unset to skip voice transcription entirely — voice notes then always
# get the standard "text only" reply, same as before this existed. Off by
# default anyway behind the voiceTranscription FeatureFlag (Standard #7), the
# per-country CountryConfig.voiceEnabled gate (false for Sierra Leone/Krio —
# see PHASE_0_FINDINGS KQ4/ADR-3), and each business's Plan.voiceEnabled.
OPENAI_API_KEY=

# DeepSeek Integration Phase 2: secondary AI provider, additive-only and
# default-off (INTEGRATION_DESIGN.md, PHASE_0_FINDINGS.md's "DeepSeek
# Integration — Phase 0" section). Not yet routed to any real feature — the
# worker only constructs the provider inertly in this phase, it is never
# passed into dispatchInboundMessage's deps. Two independent gates must both
# be set before any DeepSeek call could ever happen in a later phase:
#   1. AI_PROVIDER_DEEPSEEK_ENABLED below (boot-time kill switch)
#   2. the aiProviderDeepseek FeatureFlag / BusinessFeatureFlag (DB-backed,
#      live, no-deploy allowlist — see src/domain/featureFlags.ts)
# DEEPSEEK_API_KEY is server-side only — never logged, never sent to a
# client, same boundary as ANTHROPIC_API_KEY above.
DEEPSEEK_API_KEY=
# Defaults to "false"/unset. Leave unset until DeepSeek is actually wanted —
# read directly in src/worker.ts, mirroring the OPENAI_API_KEY/sttProvider
# conditional-construction pattern just above.
AI_PROVIDER_DEEPSEEK_ENABLED=false
# A modelRegistry.ts registry key (src/ai/modelRegistry.ts), never a raw
# vendor model string — D-3's pin-a-snapshot resolution (an operator cannot
# point this at a moving alias just by editing this var). Leave unset to use
# the registry's own pinned default.
AI_DEEPSEEK_MODEL=
# Reserved by INTEGRATION_DESIGN.md §4 for Phase 3 (budget enforcement /
# non-AI fallback) and Phase 4 (debug prompt-hash sampling): AI_FALLBACK_ENABLED,
# AI_BUDGET_ENFORCEMENT_ENABLED, AI_DEBUG_PROMPT_SAMPLING. Deliberately not
# declared here yet — nothing in this codebase reads them until the phase
# that implements the behavior they gate.

# Phase 2 admin dashboard: secret used to sign/verify admin JWTs (src/admin/auth.ts).
# Generate with e.g. `openssl rand -base64 48`. Rotating it invalidates all existing admin sessions.
ADMIN_JWT_SECRET=

# Phase 4 admin frontend (admin-frontend/): comma-separated list of browser
# origins allowed to call /admin/* cross-origin (see src/server.ts). Leave
# unset in production unless you're actually serving admin-frontend from a
# different origin than this API — an empty/unset value means no cross-origin
# browser access at all, which is the safe default for an API that issues
# admin JWTs.
# Example: ADMIN_FRONTEND_ORIGINS=http://localhost:5173
ADMIN_FRONTEND_ORIGINS=

# Admin console (admin-console Phase 2). Nothing below has a value in this file: set real values only in the deployment environment.
# Master switch: the admin API is mounted ONLY when this is exactly "true". Anything else makes every /admin path an ordinary 404.
ADMIN_CONSOLE_ENABLED=false
# Per-module switches (each also needs the master switch). Exactly "true" turns one on.
ADMIN_MODULE_MERCHANTS=
ADMIN_MODULE_STAFF=
ADMIN_MODULE_AUDIT=
ADMIN_MODULE_HEALTH=
ADMIN_MODULE_SUBSCRIPTIONS=
ADMIN_MODULE_MODERATION=
ADMIN_MODULE_ORDERS=
ADMIN_MODULE_WHATSAPP=
ADMIN_MODULE_PAYMENTS=
ADMIN_MODULE_REFUNDS=
ADMIN_MODULE_CONFIG=
ADMIN_MODULE_REPORTS=
# Refund execution stays off even when the Refunds module is on, until this is exactly "true".
ADMIN_REFUND_EXECUTION_ENABLED=false
# Second factor for staff. On unless set to "false" (an emergency switch; staff invited after Phase 2 are always held to it).
ADMIN_MFA_ENFORCE=
# 64 hex characters (32 bytes): encrypts each person's authenticator secret in the database. Required before anyone can enrol.
ADMIN_MFA_ENCRYPTION_KEY=
# WhatsApp as a second-factor option for staff (a six-digit code sent to their own number). Off unless "true" AND the template below is named.
# The template must be a Meta AUTHENTICATION template with a copy-code button, created and approved in WhatsApp Business Manager (nothing here
# creates or submits it). Language defaults to "en". Uses the same WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID as the other notices.
ADMIN_WHATSAPP_CODES_ENABLED=
WHATSAPP_ADMIN_CODE_TEMPLATE_NAME=
WHATSAPP_ADMIN_CODE_TEMPLATE_LANGUAGE=
# Session rules in whole minutes (defaults: absolute 720, idle 30, re-authentication 10, finish second factor within 15).
ADMIN_SESSION_ABSOLUTE_MINUTES=
ADMIN_SESSION_IDLE_MINUTES=
ADMIN_REAUTH_MINUTES=
ADMIN_PRE_MFA_MINUTES=
# The console's public address, used to build invitation links (for example https://admin.example.com).
ADMIN_FRONTEND_PUBLIC_URL=
# The first-owner and second-factor-reset commands run only while this is "true". Set it on the command line for one run; never leave it set on the server.
ADMIN_BOOTSTRAP_ALLOWED=
# Optional: lets scripts/createAdminUser.ts read the password from here instead of the command line.
ADMIN_NEW_PASSWORD=

# Phase 20: optional, defaults to "memory" — the admin-login and inbound-
# WhatsApp rate limiters (src/admin/rateLimiter.ts, src/whatsapp/
# inboundRateLimiter.ts) use in-memory, per-process counters unless this is
# set to "redis", in which case both share one ioredis connection built from
# REDIS_URL above (the same one BullMQ already uses). Only matters once this
# API is scaled to more than one replica — a single-replica deployment (the
# only kind docker-compose.yml runs today) behaves identically either way.
RATE_LIMIT_BACKEND=memory

# Optional email alerting for crashes and incidents (src/monitoring/alerts.ts,
# src/config/monitoringEnv.ts). All three must be set for emails to be sent;
# if any is missing, incidents are only logged to the console. ALERT_EMAIL_TO is
# comma-separated for more than one recipient.
ALERT_EMAIL_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Optional: an approved WhatsApp template used to notify a merchant that a
# customer's payment was received (src/config/paymentsEnv.ts). Both must be set
# together; unset means the notification is sent as a plain text message.
WHATSAPP_PAYMENT_RECEIVED_TEMPLATE_NAME=
WHATSAPP_PAYMENT_RECEIVED_TEMPLATE_LANGUAGE=

# Optional workaround for Meta's free/test-number allowlist quirk
# (src/config/outboundGatewayEnv.ts): comma-separated calling codes (e.g. "232" for
# Sierra Leone, "232,234" for more than one) whose recipient numbers get their
# trunk prefix handled specially. Unset means no change in behavior.
WHATSAPP_TEST_RECIPIENT_TRUNK_PREFIX_CALLING_CODES=

# Only read by scripts/test-pawapay-sandbox.ts: the MSISDN (with country code)
# to run the PawaPay sandbox deposit test against. Defaults to 23276000001.
TEST_PHONE_NUMBER=

# postgres service credentials (docker-compose.yml only)
POSTGRES_USER=tradepal
POSTGRES_PASSWORD=tradepal
POSTGRES_DB=tradepal

PORT=3000

# Optional, operator testing only: treat specific phone numbers as belonging to a launch country so
# you can test real signup from a phone whose own calling code isn't supported (e.g. a US number).
# Comma-separated number=COUNTRY pairs, whole numbers only (src/onboarding/onboardingFlow.ts).
# Leave unset in normal operation. Only the worker reads it.
ONBOARDING_TEST_NUMBER_COUNTRIES=

# ======================================================================================================================
# Expansion (B2B + B2C) settings. EVERY ONE OF THESE IS OFF / UNSET BY DEFAULT. No value below is a secret except where marked.
# Each capability also has a per-business feature flag (set in the admin console) that must be on. See docs/expansion/runbooks/.
# ======================================================================================================================

# Background sweeps (the worker). Without these, holds never lapse, provider callbacks are not processed and unresolved payments never resolve.
OPERATIONS_SWEEP_ENABLED=
OUTBOX_SWEEP_ENABLED=
# Dead-man's-switch endpoint /heartbeat and which services must be alive (default "worker"). Point an EXTERNAL uptime monitor at it.
HEARTBEAT_ENABLED=
HEARTBEAT_REQUIRED_SERVICES=
# Behind Railway/any proxy: how many proxy hops to trust, so per-client rate limits see the real address (e.g. 1).
TRUST_PROXY=

# Public shop pages (consumer storefront). The router is not mounted at all unless STOREFRONT_ENABLED=true.
STOREFRONT_ENABLED=
STOREFRONT_PUBLIC_URL=
MARKETPLACE_ENABLED=
# SIMULATED online payment for shop orders. Refused whenever NODE_ENV=production. Keep OFF anywhere real shoppers are present.
STOREFRONT_SIMULATOR_ENABLED=
# (secret) HMAC key for the simulator's signed callbacks. Any random string; never reuse a real credential.
PAYMENT_SIMULATOR_SECRET=

# pawaPay billing of TradePal's OWN subscriptions (never merchant sales). Uses PAWAPAY_API_TOKEN / PAWAPAY_API_BASE_URL above.
# SANDBOX or PRODUCTION; must agree with the base URL and NODE_ENV or billing refuses to start.
PAWAPAY_ENVIRONMENT=
# The public host name pawaPay calls back (no scheme, no path), e.g. api.example.com. Used to rebuild the callback signature base.
PAWAPAY_BILLING_CALLBACK_AUTHORITY=
# Defaults to true: a callback with no valid signature is refused. Turn off only to debug in a sandbox.
PAWAPAY_REQUIRE_SIGNED_CALLBACKS=
# Must be "true" before ANY production charge is allowed. Leave unset until docs/expansion/runbooks/production-activation.md is complete.
PAWAPAY_BILLING_PRODUCTION_ACTIVATED=

# TradePal's public WhatsApp number in international format, digits only (e.g. 2348000000000). Used for the shopper's "Start updates" link
# (wa.me). Without it no shopper can verify their number, so no order update is ever sent.
WHATSAPP_PUBLIC_NUMBER=

# Months after which a shopper's name, phone, address and notes are removed from finished shop orders (amounts and history are kept).
# Default 24; 0 turns it off. Runs daily in the operations sweep.
SHOPPER_DATA_RETENTION_MONTHS=

# Messages to shoppers. Also needs the consumerMessaging flag per seller, an APPROVED template per message class, and the shopper's opt-in.
CONSUMER_MESSAGING_ENABLED=
# (secret) key for the keyed hash of phone numbers in the outbound message log. Set once; changing it breaks matching of old rows.
MESSAGING_LOG_PEPPER=

# Couriers for delivery orders (tracking, status callbacks). Also needs the storeCourier flag per seller. No courier is chosen yet: in production
# only the built-in "manual" courier works until a real adapter is added. The simulator is for development and is refused when NODE_ENV=production.
COURIERS_ENABLED=
COURIER_SIMULATOR_ENABLED=
# (secret) signs the simulator courier's callbacks; development only
COURIER_SIMULATOR_SECRET=

# Phone page /m/ : offline drafts, reports, and the product screen (bulk edit, CSV, photos). Each also needs a per-business flag (offlineDrafts, reportsV2, catalogV2).
OFFLINE_DRAFTS_ENABLED=
REPORTS_WEB_ENABLED=
CATALOG_WEB_ENABLED=
# Shown in the /connect and /report link replies, e.g. https://app.example.com
OFFLINE_PUBLIC_URL=
