# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose.yml overrides DATABASE_URL/REDIS_URL/PORT itself to point at
# the `postgres`/`redis` services it manages — the values below are only used
# when running the server/worker directly on the host (npm run dev:server /
# npm run dev:worker) against your own Postgres/Redis instances.

DATABASE_URL=postgresql://tradepal:tradepal@localhost:5432/tradepal
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API (see PHASE_0_FINDINGS.md ADR-1). WHATSAPP_ACCESS_TOKEN
# and WHATSAPP_PHONE_NUMBER_ID are required by src/worker.ts, whose entire job
# is sending replies to inbound messages. They're read optionally by
# src/server.ts and src/subscriptionExpiryWorker.ts: both still function
# without them (the admin-triggered and hourly expire-subscriptions sweeps
# still run), just skipping the Phase 7 subscription-lapse WhatsApp
# notification rather than failing to boot over an off-by-default feature.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Phase 9: optional, and only meaningful alongside the two vars above. If you've
# created and had Meta approve a WhatsApp message template for the Phase 7
# subscription-lapse notification, set both to send it as that template instead
# of Phase 7's original free-form text (templates are deliverable outside the
# merchant's 24-hour service window; free-form text is not). The template is
# assumed to have exactly one body placeholder, filled with the lapsed plan's
# code. Leave both unset to keep the free-form-text fallback.
WHATSAPP_SUBSCRIPTION_LAPSE_TEMPLATE_NAME=
WHATSAPP_SUBSCRIPTION_LAPSE_TEMPLATE_LANGUAGE=

# Phase 18: the same opt-in as the two vars above, for the Phase 12 weekly
# business digest instead of the Phase 7 lapse notification — a digest is
# also a business-initiated send that can fall outside the merchant's
# 24-hour service window. The template is assumed to have exactly 7 body
# placeholders, one per line of the free-form digest message (see
# src/domain/businessDigest.ts's buildWeeklyDigestTemplateParams). Leave both
# unset to keep the free-form-text fallback.
WHATSAPP_WEEKLY_DIGEST_TEMPLATE_NAME=
WHATSAPP_WEEKLY_DIGEST_TEMPLATE_LANGUAGE=

# Phase 20: the same opt-in as the four vars above, for the deletion-request
# resolution notice (src/domain/deletion.ts) instead of the Phase 7 lapse
# notification or Phase 12 weekly digest — resolving a merchant's data-
# deletion request is also a business-initiated send that can fall outside
# the merchant's 24-hour service window. The template is assumed to have
# exactly 2 body placeholders: {{1}} the outcome ("completed" or "not
# approved"), {{2}} the resolution note (or a fallback string when none was
# given) — see deletion.ts's buildDeletionResolutionTemplateParams. Leave
# both unset to keep the free-form-text fallback.
WHATSAPP_DELETION_RESOLUTION_TEMPLATE_NAME=
WHATSAPP_DELETION_RESOLUTION_TEMPLATE_LANGUAGE=

# Phase 21: the same opt-in as the six vars above, for the addStaffMerchant
# proactive notification (src/domain/merchantIdentity.ts) instead of the
# other three proactive sends — a newly-added staff member may not message
# the bot within 24 hours of being invited. Unlike the other three templates,
# this one needs no body placeholders (the message carries no per-invite
# dynamic data). Leave both unset to keep the free-form-text fallback.
WHATSAPP_STAFF_ADDED_TEMPLATE_NAME=
WHATSAPP_STAFF_ADDED_TEMPLATE_LANGUAGE=

# Phase 22: Flutterwave hosted checkout (see src/domain/payments.ts,
# src/flutterwave/, PHASE_0_FINDINGS.md Phase 22 section). Backs /upgrade
# (src/commands/commandRouter.ts) and the /webhooks/flutterwave route
# (src/server.ts). All four are optional together — a deployment that hasn't
# set up Flutterwave yet still boots both src/server.ts and src/worker.ts,
# just with /upgrade reporting itself unavailable and the webhook route
# unmounted, same as every other off-by-default feature in this codebase.
#
# FLUTTERWAVE_SECRET_KEY authorizes both creating a checkout link (worker) and
# verifying a transaction server-to-server (server) — one credential, like
# WHATSAPP_ACCESS_TOKEN above.
FLUTTERWAVE_SECRET_KEY=
# The static shared-secret value configured as your Flutterwave webhook's
# "secret hash" — compared against the inbound `verif-hash` header
# (src/flutterwave/signature.ts) to authenticate the webhook call itself.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Where Flutterwave's hosted checkout page redirects the merchant's browser
# after they finish paying (never itself part of the bot conversation — see
# config/paymentsEnv.ts's doc comment).
FLUTTERWAVE_CHECKOUT_REDIRECT_URL=

# Phase 22: the same template opt-in as the four WHATSAPP_*_TEMPLATE_* pairs
# above, for the payment-confirmation notification instead of lapse/digest/
# deletion/staff-added — a completed Flutterwave checkout is itself a
# business-initiated send that can fall outside the merchant's 24-hour
# service window. The template is assumed to have exactly one body
# placeholder, filled with the newly-active plan's code. Leave both unset to
# keep the free-form-text fallback.
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE_NAME=
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE_LANGUAGE=

# AI parsing provider (see src/ai/provider.ts, PHASE_0_FINDINGS.md ADR-2)
ANTHROPIC_API_KEY=

# Voice-note transcription (see src/stt/provider.ts, src/worker.ts). Optional:
# leave unset to skip voice transcription entirely — voice notes then always
# get the standard "text only" reply, same as before this existed. Off by
# default anyway behind the voiceTranscription FeatureFlag (Standard #7), the
# per-country CountryConfig.voiceEnabled gate (false for Sierra Leone/Krio —
# see PHASE_0_FINDINGS KQ4/ADR-3), and each business's Plan.voiceEnabled.
OPENAI_API_KEY=

# Phase 2 admin dashboard: secret used to sign/verify admin JWTs (src/admin/auth.ts).
# Generate with e.g. `openssl rand -base64 48`. Rotating it invalidates all existing admin sessions.
ADMIN_JWT_SECRET=

# Phase 4 admin frontend (admin-frontend/): comma-separated list of browser
# origins allowed to call /admin/* cross-origin (see src/server.ts). Leave
# unset in production unless you're actually serving admin-frontend from a
# different origin than this API — an empty/unset value means no cross-origin
# browser access at all, which is the safe default for an API that issues
# admin JWTs.
# Example: ADMIN_FRONTEND_ORIGINS=http://localhost:5173
ADMIN_FRONTEND_ORIGINS=

# Phase 20: optional, defaults to "memory" — the admin-login and inbound-
# WhatsApp rate limiters (src/admin/rateLimiter.ts, src/whatsapp/
# inboundRateLimiter.ts) use in-memory, per-process counters unless this is
# set to "redis", in which case both share one ioredis connection built from
# REDIS_URL above (the same one BullMQ already uses). Only matters once this
# API is scaled to more than one replica — a single-replica deployment (the
# only kind docker-compose.yml runs today) behaves identically either way.
RATE_LIMIT_BACKEND=memory

# postgres service credentials (docker-compose.yml only)
POSTGRES_USER=tradepal
POSTGRES_PASSWORD=tradepal
POSTGRES_DB=tradepal

PORT=3000
