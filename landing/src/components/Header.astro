---
import { SITE, whatsappCtaHref } from "../lib/site";
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-900">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-teal-600 text-white">T</span>
      {SITE.name}
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
      <a href="#features" class="transition hover:text-slate-900">Features</a>
      <a href="#how-it-works" class="transition hover:text-slate-900">How it works</a>
      <a href="#pricing" class="transition hover:text-slate-900">Pricing</a>
      <a href="#faq" class="transition hover:text-slate-900">FAQ</a>
    </nav>

    <a
      href={whatsappCtaHref()}
      class="inline-flex items-center gap-2 rounded-full bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700"
    >
      Start on WhatsApp
    </a>
  </div>
</header>
