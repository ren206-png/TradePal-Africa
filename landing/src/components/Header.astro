---
import { SITE, whatsappCtaHref } from "../lib/site";
import Logo from "./Logo.astro";
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3.5">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <Logo class="h-9 w-9" />
      <span class="display text-[1.35rem] font-semibold leading-none text-ink">
        TradePal<span class="ml-1.5 font-sans text-[0.62rem] font-bold uppercase tracking-[0.22em] text-clay">Africa</span>
      </span>
    </a>

    <nav class="hidden items-center gap-9 text-sm font-semibold text-ink/70 md:flex" aria-label="Primary">
      <a href="/#features" class="transition hover:text-ink">Features</a>
      <a href="/#how-it-works" class="transition hover:text-ink">How it works</a>
      <a href="/#pricing" class="transition hover:text-ink">Pricing</a>
      <a href="/#faq" class="transition hover:text-ink">FAQ</a>
    </nav>

    <a
      href={whatsappCtaHref()}
      class="group inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-paper shadow-[0_2px_0_0_#e9a21b] transition hover:-translate-y-px hover:bg-ink-2 hover:shadow-[0_3px_0_0_#e9a21b]"
    >
      <span class="hidden sm:inline">Start on WhatsApp</span>
      <span class="sm:hidden">Start</span>
      <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
    </a>
  </div>
</header>
