---
import { whatsappCtaHref } from "../lib/site";

const plans = [
  {
    name: "Free",
    price: "₦0",
    period: "/month",
    description: "Everything you need to start tracking your shop's money today.",
    features: [
      "Up to 50 entries a month",
      "Debt book (/debt, /paid, /customer)",
      "Daily summary (/today)",
      "Stock tracking (/stock, /lowstock)",
      "Undo the last entry (/undo)",
    ],
    cta: "Start free",
    highlighted: false,
  },
  {
    name: "Starter",
    price: "₦5,000",
    period: "/month",
    description: "For a shop that's outgrown the free plan. Paid plans open soon; everyone starts free today.",
    features: [
      "Up to 1,000 entries a month",
      "Everything in Free",
      "Voice note logging (coming soon)",
      "Priority support",
    ],
    cta: "Start free for now",
    highlighted: true,
  },
];
---

<section id="pricing" class="mx-auto max-w-6xl px-6 py-24 lg:py-28">
  <div class="mx-auto max-w-2xl text-center">
    <p class="inline-flex items-center gap-3 text-[0.72rem] font-bold uppercase tracking-[0.22em] text-clay">
      <span class="inline-block h-[2px] w-8 bg-clay"></span>
      Pricing
      <span class="inline-block h-[2px] w-8 bg-clay"></span>
    </p>
    <h2 class="display mt-5 text-4xl font-semibold sm:text-5xl">Simple, shop-friendly pricing</h2>
    <p class="mt-4 text-lg text-ink/70">
      Start free, no card required. Prices shown in Naira; local pricing applies in Kenya, Ghana, Sierra Leone,
      Liberia, and Gambia.
    </p>
  </div>

  <div class="mx-auto mt-16 grid max-w-4xl gap-10 sm:grid-cols-2">
    {
      plans.map((plan) => (
        <div style="filter: drop-shadow(0 14px 16px rgba(15,42,34,0.16));">
          <div
            class:list={[
              "receipt flex h-full flex-col px-8 pb-12 pt-11",
              plan.highlighted ? "bg-ink text-paper" : "bg-white text-ink",
            ]}
          >
            <div class="flex min-h-7 items-center justify-between">
              <h3 class="font-mono text-sm font-semibold uppercase tracking-[0.22em]">{plan.name}</h3>
              {plan.highlighted && (
                <span class="rounded-full bg-saffron px-3 py-1 text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-ink">
                  Coming soon
                </span>
              )}
            </div>

            <p class="mt-6 flex items-baseline gap-1">
              <span class="display text-[3.6rem] font-semibold leading-none">{plan.price}</span>
              <span class:list={["text-base font-semibold", plan.highlighted ? "text-paper/60" : "text-ink/55"]}>
                {plan.period}
              </span>
            </p>
            <p class:list={["mt-4 text-sm leading-relaxed", plan.highlighted ? "text-paper/75" : "text-ink/70"]}>
              {plan.description}
            </p>

            <div class:list={["my-7 border-t-2 border-dashed", plan.highlighted ? "border-paper/25" : "border-ink/20"]}></div>

            <ul class="flex-1 space-y-3.5 text-sm font-semibold">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <svg viewBox="0 0 16 16" class:list={["mt-0.5 h-4 w-4 shrink-0", plan.highlighted ? "text-saffron" : "text-leaf"]} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m3 8.5 3.2 3L13 4.5" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href={whatsappCtaHref()}
              class:list={[
                "mt-9 block rounded-full px-6 py-3.5 text-center text-sm font-extrabold transition",
                plan.highlighted
                  ? "bg-saffron text-ink hover:bg-[#f2b134]"
                  : "bg-ink text-paper hover:bg-ink-2",
              ]}
            >
              {plan.cta}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
