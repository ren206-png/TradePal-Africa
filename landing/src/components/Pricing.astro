---
import { whatsappCtaHref } from "../lib/site";

const plans = [
  {
    name: "Free",
    price: "₦0",
    period: "/month",
    description: "Everything you need to start tracking your shop's money today.",
    features: [
      "Up to 100 entries a month",
      "Debt book (/debt, /paid, /customer)",
      "Daily summary (/today)",
      "Stock tracking (/stock, /lowstock)",
      "Undo the last entry (/undo)",
    ],
    cta: "Start free",
    highlighted: false,
  },
  {
    name: "Starter",
    price: "₦5,000",
    period: "/month",
    description: "For a shop that's outgrown the free plan and wants voice notes too.",
    features: [
      "Up to 1,000 entries a month",
      "Everything in Free",
      "Voice note logging (where supported)",
      "Priority support",
    ],
    cta: "Upgrade on WhatsApp",
    highlighted: true,
  },
];
---

<section id="pricing" class="mx-auto max-w-6xl px-6 py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Simple, shop-friendly pricing</h2>
    <p class="mt-4 text-lg text-slate-600">
      Start free, no card required. Prices shown in Naira; local pricing applies in Kenya, Ghana, and Sierra Leone.
    </p>
  </div>

  <div class="mx-auto mt-16 grid max-w-3xl gap-8 sm:grid-cols-2">
    {
      plans.map((plan) => (
        <div
          class:list={[
            "rounded-3xl border p-8",
            plan.highlighted ? "border-teal-600 bg-teal-50 shadow-lg" : "border-slate-200 bg-white",
          ]}
        >
          <h3 class="text-xl font-bold text-slate-900">{plan.name}</h3>
          <p class="mt-4">
            <span class="text-4xl font-extrabold text-slate-900">{plan.price}</span>
            <span class="text-base font-medium text-slate-500">{plan.period}</span>
          </p>
          <p class="mt-3 text-sm text-slate-600">{plan.description}</p>

          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-teal-600">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={whatsappCtaHref()}
            class:list={[
              "mt-8 block rounded-full px-6 py-3 text-center text-sm font-semibold transition",
              plan.highlighted
                ? "bg-teal-600 text-white hover:bg-teal-700"
                : "border border-slate-300 text-slate-700 hover:border-slate-400",
            ]}
          >
            {plan.cta}
          </a>
        </div>
      ))
    }
  </div>
</section>
