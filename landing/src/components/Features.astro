---
interface Feature {
  command: string;
  title: string;
  description: string;
}

const features: Feature[] = [
  {
    command: "/debt, /paid, /customer",
    title: "Debt book",
    description: "Track exactly who owes you and how much, log payments as they come in, and never lose a running balance again.",
  },
  {
    command: "/today",
    title: "Daily summary",
    description: "See today's sales, expenses, and payments received at a glance. No spreadsheet, no end-of-day math.",
  },
  {
    command: "/stock, /lowstock",
    title: "Stock tracking",
    description: "Keep an estimated running count of what's on your shelf and get a heads-up before an item runs out.",
  },
  {
    command: "/paylink",
    title: "Payment links",
    description: "Generate a one-off checkout link for any customer and forward it yourself. They pay by card or mobile money.",
  },
  {
    command: "/catalog",
    title: "Shareable catalog",
    description: "List every priced item as one block of text you can forward to a customer, ready to shop from.",
  },
  {
    command: "/momo",
    title: "Mobile money reconciliation",
    description: "Forward the mobile money SMS alert and get it automatically matched to the right sale or payment.",
  },
  {
    command: "/addstaff, /removestaff",
    title: "Team access",
    description: "Add other WhatsApp numbers so staff can log sales themselves, and revoke access the moment they leave.",
  },
  {
    command: "/remind",
    title: "Payment reminders",
    description: "Get ready-to-send reminder text for any customer with an open balance. You choose when to forward it.",
  },
];
---

<section id="features" class="relative bg-ink text-paper">
  <div class="weave-thin" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6 py-24 lg:py-28">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-end">
      <div>
        <p class="inline-flex items-center gap-3 text-[0.72rem] font-bold uppercase tracking-[0.22em] text-saffron">
          <span class="inline-block h-[2px] w-8 bg-saffron"></span>
          The ledger
        </p>
        <h2 class="display mt-5 text-4xl font-semibold sm:text-5xl">
          Everything your shop needs, <span class="italic font-medium text-saffron">one message away</span>
        </h2>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-paper/70 lg:justify-self-end">
        No dashboards to learn. Every feature below is just a message or command away in the same chat you already use.
      </p>
    </div>

    <ol class="mt-16 grid gap-x-16 md:grid-cols-2">
      {
        features.map((feature, i) => (
          <li class="group flex gap-5 border-b-2 border-dotted border-paper/20 py-8">
            <span class="pt-1 font-mono text-sm font-semibold text-saffron/80">{String(i + 1).padStart(2, "0")}</span>
            <div class="min-w-0">
              <h3 class="display text-2xl font-semibold transition group-hover:text-saffron">{feature.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-paper/70">{feature.description}</p>
              <code class="mt-4 inline-block rounded-md border border-saffron/40 bg-saffron/10 px-2.5 py-1 font-mono text-xs font-semibold text-saffron">
                {feature.command}
              </code>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
