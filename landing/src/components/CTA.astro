---
import { whatsappCtaHref } from "../lib/site";
---

<section class="mx-auto max-w-6xl px-6 py-24">
  <div class="rounded-3xl bg-teal-600 px-8 py-16 text-center shadow-xl sm:px-16">
    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      Ready to run your shop from WhatsApp?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-teal-50">
      It takes one message to get started, and it's free. No card, no app, no downtime.
    </p>
    <a
      href={whatsappCtaHref()}
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-8 py-3 text-base font-semibold text-teal-700 shadow-md transition hover:bg-teal-50"
    >
      Message us to get started
    </a>
  </div>
</section>
