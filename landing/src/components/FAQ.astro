---
import { SITE } from "../lib/site";

const faqs = [
  {
    question: "Do I need to download an app?",
    answer: `No. Everything happens inside the WhatsApp you already use — there's nothing new to install and nothing to learn from scratch.`,
  },
  {
    question: "Which countries do you support?",
    answer: `${SITE.name} is built for shop owners in ${SITE.supportedCountries.join(", ")} today, with more countries on the way.`,
  },
  {
    question: "Will TradePal message my customers?",
    answer:
      "Never. TradePal only ever replies to you, the merchant. Payment links, reminders, and your catalog are text you choose to copy and forward yourself.",
  },
  {
    question: "How do I get paid online?",
    answer:
      "The /paylink command generates a one-off checkout link your customer can pay by card or mobile money — you just forward it to them on WhatsApp.",
  },
  {
    question: "Can my staff use it too?",
    answer:
      "Yes. /addstaff lets you give another WhatsApp number access to log sales and expenses for your business, and /removestaff revokes it instantly.",
  },
  {
    question: "What does it cost?",
    answer:
      "The Free plan covers up to 50 entries a month at no cost. Starter is ₦5,000/month for up to 1,000 entries and voice note logging.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<section id="faq" class="grain bg-paper-2 py-24 lg:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="inline-flex items-center gap-3 text-[0.72rem] font-bold uppercase tracking-[0.22em] text-clay">
        <span class="inline-block h-[2px] w-8 bg-clay"></span>
        Good to know
      </p>
      <h2 class="display mt-5 text-4xl font-semibold sm:text-5xl">Frequently asked questions</h2>
      <p class="mt-4 max-w-sm text-lg text-ink/70">
        Anything else? Start a chat and type /help to see everything TradePal can do.
      </p>
    </div>

    <div class="divide-y-2 divide-dotted divide-ink/25 border-y-2 border-dotted border-ink/25">
      {
        faqs.map((faq) => (
          <details class="faq group py-6">
            <summary class="flex items-center justify-between gap-6 text-left">
              <span class="display text-xl font-semibold leading-snug sm:text-[1.4rem]">{faq.question}</span>
              <span class="faq-plus flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 border-ink/25 text-ink transition duration-300 group-open:border-ink group-open:bg-saffron" aria-hidden="true">
                <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>
              </span>
            </summary>
            <p class="mt-4 max-w-2xl pr-12 text-[0.98rem] leading-relaxed text-ink/75">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</section>
