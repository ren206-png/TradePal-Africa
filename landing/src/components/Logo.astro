---
interface Props {
  /** Tailwind size classes for the square mark. */
  class?: string;
}
const { class: className = "h-9 w-9" } = Astro.props;
---

<!-- TradePal mark: a chat bubble (WhatsApp) holding a "T" and a saffron coin (the books). -->
<svg viewBox="0 0 36 36" class={className} role="img" aria-label="TradePal Africa" xmlns="http://www.w3.org/2000/svg">
  <rect width="36" height="36" rx="10" fill="#0f2a22"></rect>
  <path
    d="M9.5 7.5h17a3.5 3.5 0 0 1 3.5 3.5v10a3.5 3.5 0 0 1-3.5 3.5H18l-6 4.5V24.5H9.5A3.5 3.5 0 0 1 6 21V11a3.5 3.5 0 0 1 3.5-3.5Z"
    fill="#f7f1e5"></path>
  <rect x="11.5" y="11.6" width="12" height="2.8" rx="1" fill="#0f2a22"></rect>
  <rect x="16" y="11.6" width="2.8" height="9.8" rx="1" fill="#0f2a22"></rect>
  <circle cx="24.2" cy="20.6" r="2.2" fill="#e9a21b"></circle>
</svg>
