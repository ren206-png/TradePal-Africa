---
import { SITE, whatsappCtaHref } from "../lib/site";
---

<section class="relative overflow-hidden bg-gradient-to-b from-teal-50 to-white">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2 md:py-28">
    <div>
      <p class="mb-4 inline-flex items-center rounded-full bg-teal-100 px-3 py-1 text-sm font-semibold text-teal-800">
        WhatsApp-native business tracking
      </p>
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl">
        Run your shop's books right inside WhatsApp
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600">
        {SITE.name} turns the WhatsApp you already use every day into a bookkeeping, stock, and payment-collection
        tool for your business — no app to download, no training required. Just chat like you always do.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={whatsappCtaHref()}
          class="inline-flex items-center gap-2 rounded-full bg-teal-600 px-6 py-3 text-base font-semibold text-white shadow-md transition hover:bg-teal-700"
        >
          Start free on WhatsApp
        </a>
        <a
          href="#how-it-works"
          class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-6 py-3 text-base font-semibold text-slate-700 transition hover:border-slate-400"
        >
          See how it works
        </a>
      </div>

      <p class="mt-6 text-sm text-slate-500">
        Built for shop owners in {SITE.supportedCountries.join(", ")} — free to start, no card required.
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-sm">
      <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-xl">
        <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
          <span class="h-3 w-3 rounded-full bg-teal-500"></span>
          <span class="text-sm font-semibold text-slate-700">{SITE.name}</span>
        </div>

        <div class="mt-4 space-y-3">
          <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-teal-600 px-4 py-2 text-sm text-white">
            sold 2 bags of rice for 12000
          </div>
          <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-slate-100 px-4 py-2 text-sm text-slate-800">
            Logged: Sale of ₦12,000.00. Nice one! 🎉
          </div>
          <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-teal-600 px-4 py-2 text-sm text-white">
            /today
          </div>
          <div class="max-w-[85%] whitespace-pre-line rounded-2xl rounded-tl-sm bg-slate-100 px-4 py-2 text-sm text-slate-800">
            {"Today (Africa/Lagos):\nSales: 12,000.00\nExpenses: 0.00\nNet: 12,000.00"}
          </div>
          <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-teal-600 px-4 py-2 text-sm text-white">
            /paylink Amina 5000
          </div>
          <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-slate-100 px-4 py-2 text-sm text-slate-800">
            Send this link to Amina to collect ₦5,000.00 👇
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
