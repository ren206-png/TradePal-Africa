datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────
// Reference / master data
// ─────────────────────────────────────────────────────────────────────────

model Country {
  code            String   @id // ISO 3166-1 alpha-2: NG, KE, SL, GH
  name            String
  callingCode     String // e.g. "234"
  defaultCurrency String // FK -> Currency.code
  defaultTimezone String // IANA tz, e.g. Africa/Lagos
  createdAt       DateTime @default(now()) @db.Timestamptz()

  currency      Currency        @relation(fields: [defaultCurrency], references: [code])
  countryConfig CountryConfig[]
  businesses    Business[]

  @@index([defaultCurrency])
}

model Currency {
  priceLists     PriceList[]
  journalEntries JournalEntry[]
  code           String         @id // ISO 4217, e.g. NGN, KES, GHS, SLE, TZS
  name           String
  minorUnitExp   Int // decimal places of the minor unit; TZS documented as 0 (whole shilling treated as minor unit)

  countries       Country[]
  businesses      Business[]
  transactions    Transaction[]
  debts           Debt[]
  plans           Plan[]
  invoices        Invoice[]
  paymentRequests PaymentRequest[]
}

model Language {
  code String @id // e.g. en, pcm (Nigerian Pidgin), sw (Swahili/Sheng), kri (Krio), tw (Twi)
  name String

  countryConfigs CountryConfig[]
  businesses     Business[]
}

model CountryConfig {
  id                  String  @id @default(uuid())
  countryCode         String
  defaultLanguage     String
  voiceEnabled        Boolean @default(false) // Krio (Sierra Leone) launches text-first per Phase 0 KQ4 finding
  asrProviderConfig   Json? // per-country ASR provider selection, null when voiceEnabled is false
  waTemplateNamespace String?

  country  Country  @relation(fields: [countryCode], references: [code])
  language Language @relation(fields: [defaultLanguage], references: [code])

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([countryCode])
  @@index([countryCode])
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy: Business (the shop) and Merchant (the WhatsApp-identified operator)
// ─────────────────────────────────────────────────────────────────────────

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model Business {
  products           Product[]
  productVariants    ProductVariant[]
  variantAliases     VariantAlias[]
  packConversions    PackConversion[]
  priceLists         PriceList[]
  priceRules         PriceRule[]
  stockMovements     StockMovement[]
  stockBalances      StockBalance[]
  stockReservations  StockReservation[]
  stockCounts        StockCount[]
  stockCountLines    StockCountLine[]
  stockTransfers     StockTransfer[]
  stockTransferLines StockTransferLine[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  dailyCloses        DailyClose[]
  stockPolicy        StockPolicy?
  id                 String              @id @default(uuid())
  name               String
  countryCode        String
  currencyCode       String
  languageCode       String
  timezone           String // IANA tz stored explicitly on the business (KQ7): all "today"/"week" boundaries computed here
  // Phase 29: platform-moderation suspension (src/domain/businessModeration.ts),
  // distinct from Merchant.removedAt's per-staff soft-deactivation — this cuts
  // off every merchant on the business at once, for a platform-rules
  // violation. suspendedAt/suspensionReason are null whenever status is
  // ACTIVE (reinstateBusiness clears them). Enforced in the live message path
  // by messageDispatcher.ts's own gate, not just by hiding admin UI.
  status             BusinessStatus      @default(ACTIVE)
  suspendedAt        DateTime?           @db.Timestamptz()
  /// True only for synthetic/test/demo organizations. The ONLY businesses whose financial rows may ever be hard-deleted
  /// (database triggers enforce this); set at creation and immutable afterwards. See docs/expansion/db-protection.md.
  isSynthetic        Boolean             @default(false)
  suspensionReason   String?
  createdAt          DateTime            @default(now()) @db.Timestamptz()
  updatedAt          DateTime            @updatedAt @db.Timestamptz()

  country  Country  @relation(fields: [countryCode], references: [code])
  currency Currency @relation(fields: [currencyCode], references: [code])
  language Language @relation(fields: [languageCode], references: [code])

  merchants            Merchant[]
  users                User[]
  transactions         Transaction[]
  transactionItems     TransactionItem[]
  customers            Customer[]
  suppliers            Supplier[]
  debts                Debt[]
  debtPayments         DebtPayment[]
  inventoryItems       InventoryItem[]
  inventoryMovements   InventoryMovement[]
  reminders            Reminder[]
  whatsappMessages     WhatsAppMessage[]
  mobileMoneyAlerts    MobileMoneyAlert[]
  aiParseLogs          AiParseLog[]
  subscriptions        Subscription[]
  auditLogs            AuditLog[]
  consentLogs          ConsentLog[]
  deletionRequests     DeletionRequest[]
  businessFeatureFlags BusinessFeatureFlag[]
  paymentRequests      PaymentRequest[]
  aiUsageLedgerEntries AiUsageLedger[]
  shops                Shop[]
  memberships          Membership[]
  supportAccesses      SupportAccess[]

  @@index([countryCode])
}

enum MerchantRole {
  OWNER
  STAFF
}

/// What a person may do inside one business (expansion Phase 1). The permission matrix lives in src/auth/permissions.ts.
/// Legacy mapping: Merchant OWNER -> OWNER, Merchant STAFF -> SALES_CLERK.
enum MembershipRole {
  OWNER
  MANAGER
  SALES_CLERK
  INVENTORY_OPERATOR
  FINANCE_OPERATOR
  RESTRICTED_SUPPORT
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

/// A physical or logical shop inside a business (tenant). Every business has exactly one default shop; more can be added
/// in later phases. Additive: no existing table references Shop yet.
model Shop {
  stockMovements    StockMovement[]
  stockBalances     StockBalance[]
  stockReservations StockReservation[]
  stockCounts       StockCount[]
  transfersFrom     StockTransfer[]    @relation("TransferFrom")
  transfersTo       StockTransfer[]    @relation("TransferTo")
  id                String             @id @default(uuid())
  businessId        String
  name              String
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.Timestamptz()
  updatedAt         DateTime           @updatedAt @db.Timestamptz()

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([businessId, name])
  @@index([businessId])
}

/// Links a verified person (their WhatsApp number, normalized) to a business with a role, optionally limited to one shop.
/// Lets one person belong to several businesses and be revoked without losing history. The legacy `Merchant` row stays the
/// source of truth for the WhatsApp conversation; memberships are kept in sync by src/domain/memberships.ts.
model Membership {
  id          String           @id @default(uuid())
  businessId  String
  /// null = every shop of the business.
  shopId      String?
  phoneNumber String
  role        MembershipRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @db.Timestamptz()
  revokedAt   DateTime?        @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shop     Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([businessId, phoneNumber])
  @@index([phoneNumber])
  @@index([businessId])
}

/// Which business (and shop) a person is currently acting in, when they belong to more than one. Never guessed from
/// the phone number or the last conversation: set explicitly (src/domain/memberships.ts setActiveContext).
model ActiveContext {
  phoneNumber String   @id
  businessId  String
  shopId      String?
  updatedAt   DateTime @updatedAt @db.Timestamptz()
}

enum OnboardingStep {
  AWAITING_COUNTRY
  AWAITING_LANGUAGE
  AWAITING_BUSINESS_NAME
  AWAITING_CONSENT
  AWAITING_FIRST_CUSTOMER
  COMPLETE
}

model Merchant {
  id             String         @id @default(uuid())
  businessId     String
  phoneNumber    String         @unique // WhatsApp number = merchant identity (KQ6)
  role           MerchantRole   @default(OWNER)
  onboardingStep OnboardingStep @default(AWAITING_COUNTRY)
  // Phase 14: /removestaff soft-deactivates a STAFF merchant rather than
  // deleting the row (preserves AuditLog/ConsentLog history, and keeps
  // Merchant.phoneNumber's own row around so recordAuditLog's entityId FKs
  // never dangle). null = active. Never set for an OWNER (see removeStaffMerchant).
  removedAt      DateTime?      @db.Timestamptz()
  createdAt      DateTime       @default(now()) @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @db.Timestamptz()

  business    Business     @relation(fields: [businessId], references: [id])
  consentLogs ConsentLog[]

  @@index([businessId])
}

/// Placeholder for future magic-link merchant dashboard login (Phase 4). Not used by the Phase 1 conversation flow.
model User {
  id         String   @id @default(uuid())
  businessId String
  merchantId String?  @unique
  createdAt  DateTime @default(now()) @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

enum AdminRole {
  SUPER_ADMIN
  ANALYST
  SUPPORT
  /// Platform operator (expansion Phase 1): runs day-to-day operations (replays, exception queues, flags) without owner-only powers.
  OPERATOR
}

/// Internal TradePal staff — never tenant-scoped, backs the Phase 2 admin dashboard (read-only first, RBAC before any write).
model AdminUser {
  supportAccesses SupportAccess[]
  id              String          @id @default(uuid())
  email           String          @unique
  name            String
  role            AdminRole
  passwordHash    String // bcrypt hash (see src/admin/auth.ts) — never stores or logs the raw password
  createdAt       DateTime        @default(now()) @db.Timestamptz()
}

/// Revocation list for admin JWTs (see src/admin/tokenRevocation.ts). A stateless JWT can't be
/// invalidated on its own — POST /admin/logout inserts the token's `jti` here, and
/// requireAdminAuth checks it on every request. Rows are opportunistically pruned once
/// `expiresAt` passes, since the token would be rejected on expiry alone at that point.
model RevokedAdminToken {
  jti       String   @id
  expiresAt DateTime @db.Timestamptz()
  revokedAt DateTime @default(now()) @db.Timestamptz()
}

// ─────────────────────────────────────────────────────────────────────────
// Ledger core — append-only
// ─────────────────────────────────────────────────────────────────────────

enum TransactionType {
  SALE
  PURCHASE
  PAYMENT_RECEIVED
  EXPENSE
  DEBT_NOTE
  STOCK_ADJUSTMENT
}

enum PaymentStatus {
  PAID
  CREDIT
  PARTIAL
}

/// Append-only. No UPDATE or DELETE is permitted on a posted row at the application layer —
/// corrections happen exclusively via a new row with reversalOfTransactionId set. Enforced by
/// TenantScopedClient (src/db/tenantScope.ts), which blocks `.update` and `.delete` for this model.
model Transaction {
  id                      String          @id @default(uuid())
  businessId              String
  type                    TransactionType
  amountMinor             BigInt // integer minor units — never a float. See src/domain/money.ts.
  currencyCode            String
  paymentStatus           PaymentStatus
  customerId              String?
  supplierId              String?
  description             String? // merchant-facing one-line summary
  rawMerchantText         String? // the original message that produced this row, for audit/undo context
  whatsappMessageId       String?
  reversalOfTransactionId String?         @unique // set only on a reversal row; original rows leave this null
  createdAt               DateTime        @default(now()) @db.Timestamptz()

  business Business  @relation(fields: [businessId], references: [id])
  currency Currency  @relation(fields: [currencyCode], references: [code])
  customer Customer? @relation(fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  reversalOf Transaction? @relation("Reversal", fields: [reversalOfTransactionId], references: [id])
  reversedBy Transaction? @relation("Reversal")

  items              TransactionItem[]
  debtsCreated       Debt[]              @relation("DebtOriginTransaction")
  debtPayments       DebtPayment[]
  inventoryMovements InventoryMovement[]
  aiParseLogs        AiParseLog[]
  mobileMoneyMatch   MobileMoneyAlert[]

  @@index([businessId, createdAt])
  @@index([businessId, type])
  @@index([businessId, customerId])
}

model TransactionItem {
  id              String  @id @default(uuid())
  businessId      String // denormalized from transaction so tenant-scoping can be enforced mechanically without a join
  transactionId   String
  inventoryItemId String?
  itemName        String
  quantity        Int
  unitPriceMinor  BigInt
  lineTotalMinor  BigInt // must equal quantity * unitPriceMinor within rounding — validated in the AI parsing layer, not just here

  business      Business       @relation(fields: [businessId], references: [id])
  transaction   Transaction    @relation(fields: [transactionId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([businessId])
  @@index([transactionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Customers, suppliers, debts
// ─────────────────────────────────────────────────────────────────────────

enum RiskLabel {
  UNKNOWN
  GOOD_PAYER
  LATE_PAYER
  RISKY
}

/// Deliberately has no phone number field: per Phase 0 KQ5, TradePal never resolves or stores a
/// WhatsApp/phone number for a merchant's customer, since that person has not consented to TradePal
/// processing their data. Only the merchant-given label is stored.
model Customer {
  priceLists   PriceList[]
  id           String      @id @default(uuid())
  businessId   String
  name         String // merchant-given label, e.g. "John the tailor" — anonymized to a placeholder on deletion request
  riskLabel    RiskLabel   @default(UNKNOWN) // derived only from payment history (src/domain/riskLabel.ts), never from AI inference
  isAnonymized Boolean     @default(false)
  createdAt    DateTime    @default(now()) @db.Timestamptz()
  updatedAt    DateTime    @updatedAt @db.Timestamptz()

  business        Business         @relation(fields: [businessId], references: [id])
  transactions    Transaction[]
  debts           Debt[]
  reminders       Reminder[]
  paymentRequests PaymentRequest[]

  @@index([businessId, name])
}

model Supplier {
  id         String   @id @default(uuid())
  businessId String
  name       String
  note       String?
  createdAt  DateTime @default(now()) @db.Timestamptz()

  business     Business      @relation(fields: [businessId], references: [id])
  transactions Transaction[]

  @@index([businessId, name])
}

enum DebtStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF
}

model Debt {
  id                     String     @id @default(uuid())
  businessId             String
  customerId             String
  originTransactionId    String?
  originalAmountMinor    BigInt
  outstandingAmountMinor BigInt
  currencyCode           String
  dueDate                DateTime?  @db.Timestamptz()
  status                 DebtStatus @default(OPEN)
  createdAt              DateTime   @default(now()) @db.Timestamptz()
  updatedAt              DateTime   @updatedAt @db.Timestamptz()

  business          Business      @relation(fields: [businessId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  originTransaction Transaction?  @relation("DebtOriginTransaction", fields: [originTransactionId], references: [id])
  currency          Currency      @relation(fields: [currencyCode], references: [code])
  payments          DebtPayment[]
  reminders         Reminder[]

  @@index([businessId, status])
  @@index([businessId, customerId])
}

model DebtPayment {
  id            String   @id @default(uuid())
  businessId    String // denormalized from debt so tenant-scoping can be enforced mechanically without a join
  debtId        String
  transactionId String
  amountMinor   BigInt
  createdAt     DateTime @default(now()) @db.Timestamptz()

  business    Business    @relation(fields: [businessId], references: [id])
  debt        Debt        @relation(fields: [debtId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([businessId])
  @@index([debtId])
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory — approximate mode, never blocks a sale
// ─────────────────────────────────────────────────────────────────────────

model InventoryItem {
  variant           ProductVariant?
  id                String          @id @default(uuid())
  businessId        String
  name              String
  // Phase 17: lowercased/trimmed mirror of `name`, maintained by the application layer
  // (not a DB trigger/generated column — Prisma has no portable support for either here).
  // Backs the `@@unique` below, which closes the race where two concurrent WhatsApp
  // messages naming the same brand-new item for the first time (e.g. both say "Bread")
  // could previously create two separate rows: `findOrCreateInventoryItem`'s prior
  // check-then-create had no DB backstop, unlike `Merchant.phoneNumber`'s `@unique`.
  // Postgres has no case-insensitive unique constraint without `citext`/an expression
  // index, so the app computes this column itself on every write.
  normalizedName    String
  unit              String? // e.g. "bottle", "bag", "kg"
  estimatedStockQty Int             @default(0) // an estimate; a sale is never blocked by this reaching zero
  lowStockThreshold Int?
  // Phase 24: set via /setprice. Nullable — most items still have no price, same as lowStockThreshold.
  priceMinor        BigInt?
  createdAt         DateTime        @default(now()) @db.Timestamptz()
  updatedAt         DateTime        @updatedAt @db.Timestamptz()

  business  Business            @relation(fields: [businessId], references: [id])
  items     TransactionItem[]
  movements InventoryMovement[]

  @@unique([businessId, normalizedName])
  @@index([businessId, name])
}

enum MovementSource {
  SALE
  PURCHASE
  ADJUSTMENT
  SHRINKAGE_UNKNOWN
}

model InventoryMovement {
  id              String         @id @default(uuid())
  businessId      String
  inventoryItemId String
  quantityDelta   Int // signed
  source          MovementSource
  transactionId   String?
  createdAt       DateTime       @default(now()) @db.Timestamptz()

  business      Business      @relation(fields: [businessId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])

  @@index([businessId, inventoryItemId])
}

// ─────────────────────────────────────────────────────────────────────────
// Reminders — merchant-forwarded only (KQ2). Never sent to a customer directly.
// ─────────────────────────────────────────────────────────────────────────

model Reminder {
  id                    String   @id @default(uuid())
  businessId            String
  customerId            String
  debtId                String?
  languageCode          String
  generatedText         String
  deliveredToMerchantAt DateTime @db.Timestamptz()
  createdAt             DateTime @default(now()) @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  debt     Debt?    @relation(fields: [debtId], references: [id])

  @@index([businessId, customerId])
}

// ─────────────────────────────────────────────────────────────────────────
// WhatsApp plumbing
// ─────────────────────────────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model WhatsAppMessage {
  id          String           @id @default(uuid())
  businessId  String? // nullable: inbound messages before onboarding resolves a business
  waMessageId String           @unique
  direction   MessageDirection
  fromNumber  String
  toNumber    String
  messageType String // text, audio, template, etc.
  rawPayload  Json
  createdAt   DateTime         @default(now()) @db.Timestamptz()

  business Business? @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Dedupe table for Meta webhook retries. Unique constraint on waMessageId is the enforcement
/// mechanism for exactly-once processing (KQ / Non-Negotiable Standard #3).
model WebhookEvent {
  id          String        @id @default(uuid())
  waMessageId String        @unique
  payload     Json
  status      WebhookStatus @default(PENDING)
  receivedAt  DateTime      @default(now()) @db.Timestamptz()
  processedAt DateTime?     @db.Timestamptz()
}

// ─────────────────────────────────────────────────────────────────────────
// Mobile money reconciliation (Phase 3, schema now)
// ─────────────────────────────────────────────────────────────────────────

enum MatchStatus {
  UNMATCHED
  SUGGESTED
  CONFIRMED
}

model MobileMoneyAlert {
  id                    String      @id @default(uuid())
  businessId            String
  provider              String
  amountMinor           BigInt
  currencyCode          String
  senderMasked          String?
  providerTransactionId String?
  rawText               String
  matchStatus           MatchStatus @default(UNMATCHED)
  matchedTransactionId  String?
  createdAt             DateTime    @default(now()) @db.Timestamptz()

  business           Business     @relation(fields: [businessId], references: [id])
  matchedTransaction Transaction? @relation(fields: [matchedTransactionId], references: [id])

  @@index([businessId, matchStatus])
}

// ─────────────────────────────────────────────────────────────────────────
// AI parsing audit trail
// ─────────────────────────────────────────────────────────────────────────

enum IntentType {
  SALE
  PURCHASE
  PAYMENT_RECEIVED
  EXPENSE
  DEBT_NOTE
  STOCK_ADJUSTMENT
  QUERY
  GREETING
  UNKNOWN
}

enum ConfidenceTier {
  HIGH
  MEDIUM
  LOW
}

enum FinalAction {
  AUTO_LOGGED
  CLARIFIED_THEN_LOGGED
  CONFIRMED_THEN_LOGGED
  REJECTED
  ANSWERED // for query/greeting intents that never produce a transaction
}

/// Every parse — raw input, raw output, validation result, final action — is logged here.
/// A validation failure must never result in a persisted transaction (see src/ai/parse.ts).
model AiParseLog {
  id                     String         @id @default(uuid())
  businessId             String?
  whatsappMessageId      String?
  rawInput               String
  rawModelOutput         Json
  intent                 IntentType
  confidenceScore        Float
  confidenceTier         ConfidenceTier
  validationPassed       Boolean
  validationErrors       Json?
  finalAction            FinalAction
  resultingTransactionId String?
  createdAt              DateTime       @default(now()) @db.Timestamptz()

  business             Business?    @relation(fields: [businessId], references: [id])
  resultingTransaction Transaction? @relation(fields: [resultingTransactionId], references: [id])

  @@index([businessId, createdAt])
}

/// DeepSeek Integration Phase 3 (INTEGRATION_DESIGN.md §3): distinct from AiParseLog above —
/// AiParseLog is the existing, single-provider parse-audit trail (Anthropic only, businessId
/// optional since a parse can predate onboarding); AiUsageLedger is the new, provider-agnostic
/// *cost* ledger backing Phase 3's budget governance, businessId required (see model doc below).
enum AIProviderId {
  ANTHROPIC
  DEEPSEEK
}

/// RESERVE happens before a call is made (an estimated-cost hold); the same requestId then gets
/// exactly one terminal row — COMMIT on success (actual cost known) or RELEASE on abort/timeout/
/// error (no charge). See AiUsageLedger's own doc comment for why this is two-phase, append-only
/// accounting rather than a single mutable-status row.
enum AIUsagePhase {
  RESERVE
  COMMIT
  RELEASE
}

/// Every row is an INSERT, never an UPDATE — this table is deliberately NOT added to
/// src/db/tenantScope.ts's APPEND_ONLY_MODELS enforcement set, because unlike Transaction there
/// is no update path to block in the first place: a reservation is one RESERVE row, and its
/// outcome is always a *second*, separate row (COMMIT or RELEASE) sharing the same requestId,
/// never a mutation of the first. This extends the same immutable-ledger precedent Transaction
/// already established (src/db/tenantScope.ts's own APPEND_ONLY_MODELS doc comment) to a second
/// table, by construction rather than by needing the same enforcement mechanism.
///
/// "Current open budget" for a business = SUM(estimatedCostMicroUsd WHERE phase=RESERVE AND
/// requestId has no terminal COMMIT/RELEASE row) + SUM(actualCostMicroUsd WHERE phase=COMMIT AND
/// createdAt within the current window) — see src/domain/aiUsageLedger.ts's
/// getOpenBudgetMicroUsdForBusiness, which computes exactly this. A RESERVE row with no terminal
/// row (a "leaked reservation" — e.g. the process crashed between the vendor call and recording
/// its outcome) is directly queryable this way rather than needing a separate leak-tracking
/// mechanism; src/domain/aiUsageLedger.ts's own tests assert this state can be constructed and
/// observed.
///
/// businessId is required (unlike AiParseLog.businessId): every DeepSeek-eligible task class in
/// this increment is a post-onboarding, business-scoped read (Phase 0's domain correction —
/// DeepSeek never touches PII/ledger/pre-onboarding flows), so there is no legitimate
/// business-less row for this table.
model AiUsageLedger {
  id                    String       @id @default(uuid())
  requestId             String // groups a RESERVE row with its terminal COMMIT/RELEASE row
  phase                 AIUsagePhase
  businessId            String
  feature               String // validated against the AIFeature TS union (src/ai/aiTypes.ts) at the app layer, not a DB enum, so adding a feature tag needs no migration
  provider              AIProviderId
  requestedModel        String
  resolvedModel         String
  estimatedCostMicroUsd BigInt? // set on RESERVE rows only — never a float, matches src/domain/money.ts
  actualCostMicroUsd    BigInt? // set on COMMIT rows only — never a float
  promptHash            String // sha256 hex of the prompt text; never the prompt itself (Constraint #5 — no raw prompt content persisted)
  idempotencyKey        String // the same waMessageId already used for BullMQ-level dedupe (src/queue/inboundMessageQueue.ts:18) — no new concept
  httpStatus            Int?
  errorClass            String? // populated on RELEASE only: mirrors AIResult's own "kind" union (src/ai/aiTypes.ts)
  createdAt             DateTime     @default(now()) @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([requestId])
  @@index([idempotencyKey, provider])
}

// ─────────────────────────────────────────────────────────────────────────
// Billing (Phase 3, schema now)
// ─────────────────────────────────────────────────────────────────────────

model Plan {
  code                            String   @id // e.g. FREE, STARTER
  name                            String
  priceMinor                      BigInt
  currencyCode                    String
  entryCapPerMonth                Int? // null = uncapped
  voiceEnabled                    Boolean  @default(false)
  // Phase 14: caps how many STAFF-role Merchant rows a business's /addstaff
  // can create. null = uncapped. Mirrors entryCapPerMonth's null-is-uncapped
  // convention exactly; the OWNER is never counted against this cap.
  staffCapCount                   Int?
  // DeepSeek Integration Phase 3 (INTEGRATION_DESIGN.md §3): per-plan monthly
  // spend cap for DeepSeek-routed AI calls, in integer micro-USD (never a
  // float — matches src/domain/money.ts). null = uncapped, mirroring
  // entryCapPerMonth's existing null-is-uncapped convention exactly.
  // Consumed by src/domain/aiBudget.ts's graduated threshold evaluator, not
  // enforced at all while AI_BUDGET_ENFORCEMENT_ENABLED=false (default).
  aiDeepseekMonthlyBudgetMicroUsd BigInt?
  createdAt                       DateTime @default(now()) @db.Timestamptz()

  currency      Currency       @relation(fields: [currencyCode], references: [code])
  subscriptions Subscription[]
}

enum SubscriptionStatus {
  // Phase 22: a checkout link was generated (an Invoice exists) but Flutterwave
  // hasn't yet confirmed payment. Distinct from ACTIVE so a business that never
  // completes checkout doesn't look subscribed, and from PAST_DUE so
  // subscriptionExpiry.ts's lapse sweep (which only ever targets ACTIVE rows)
  // never touches it.
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                 String             @id @default(uuid())
  businessId         String
  planCode           String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @db.Timestamptz()
  currentPeriodEnd   DateTime           @db.Timestamptz()
  createdAt          DateTime           @default(now()) @db.Timestamptz()

  business Business  @relation(fields: [businessId], references: [id])
  plan     Plan      @relation(fields: [planCode], references: [code])
  invoices Invoice[]

  @@index([businessId])
}

/// Which kind of money a payment record is (expansion decisions G5-G7; see src/domain/paymentPurpose.ts).
/// PLATFORM_SUBSCRIPTION = a business paying TradePal; MERCHANT_SALE = a merchant's customer paying that merchant.
enum PaymentPurpose {
  PLATFORM_SUBSCRIPTION
  MERCHANT_SALE
}

model Invoice {
  id                String         @id @default(uuid())
  subscriptionId    String
  amountMinor       BigInt
  currencyCode      String
  status            String // PENDING, PAID, FAILED
  purpose           PaymentPurpose @default(PLATFORM_SUBSCRIPTION)
  dueDate           DateTime       @db.Timestamptz()
  paidAt            DateTime?      @db.Timestamptz()
  createdAt         DateTime       @default(now()) @db.Timestamptz()
  // Phase 22: reconciles a Flutterwave webhook back to this Invoice. tx_ref is
  // a string we generate at checkout-link creation time and pass to
  // Flutterwave; it comes back unchanged on both the webhook payload and the
  // Verify Transaction API response, so it (not Flutterwave's own numeric
  // transaction id, which we don't have until the webhook fires) is what we
  // hand to Flutterwave up front. @unique also gives us idempotency: a
  // replayed webhook for the same tx_ref finds the same already-PAID row
  // instead of creating a duplicate charge record. providerCode is nullable
  // because every Invoice created before Phase 22 has no provider at all.
  providerCode      String?
  providerReference String?        @unique

  subscription Subscription     @relation(fields: [subscriptionId], references: [id])
  currency     Currency         @relation(fields: [currencyCode], references: [code])
  provider     PaymentProvider? @relation(fields: [providerCode], references: [code])

  @@index([subscriptionId])
}

model PaymentProvider {
  code        String   @id // PAYSTACK, MPESA, FLUTTERWAVE, MTN_MOMO, AIRTEL_MONEY, MONIME
  countryCode String
  config      Json
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz()

  invoices        Invoice[]
  paymentRequests PaymentRequest[]

  @@index([countryCode])
}

/// Phase 24: a merchant-initiated request for one of their own customers to pay via
/// Flutterwave (`/paylink`), as opposed to Invoice which is TradePal's own subscription
/// billing of the merchant. Tenant-scoped (direct businessId), unlike Invoice.
model PaymentRequest {
  id                String         @id @default(uuid())
  businessId        String
  customerId        String?
  description       String
  amountMinor       BigInt
  currencyCode      String
  status            String // PENDING, PAID, FAILED, EXPIRED
  purpose           PaymentPurpose @default(MERCHANT_SALE)
  // Phase 24: same reconciliation role as Invoice.providerReference (see comment there),
  // but prefixed "tpr_" (vs Invoice's "tp_") so the two txRef namespaces never collide even
  // though they live in different tables/unique constraints.
  providerCode      String?
  providerReference String?        @unique
  checkoutUrl       String?
  // Set once confirmPaymentRequestPayment records the sale via recordTransaction.
  transactionId     String?
  createdAt         DateTime       @default(now()) @db.Timestamptz()
  paidAt            DateTime?      @db.Timestamptz()

  business       Business         @relation(fields: [businessId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id])
  currency       Currency         @relation(fields: [currencyCode], references: [code])
  provider       PaymentProvider? @relation(fields: [providerCode], references: [code])
  pawaPayDeposit PawaPayDeposit?

  @@index([businessId])
}

/// PawaPay mobile-money collection tied to exactly one PaymentRequest (one-to-one: a failed
/// deposit means a new /collect, i.e. a new PaymentRequest). `id` IS the PawaPay depositId — a
/// caller-generated UUIDv4 that's stored here BEFORE the API call, so a dropped connection can
/// always be reconciled with checkDepositStatus. Standard #9: the payer's mobile-money number is
/// needed once, at initiation, and is deliberately never stored — only its last 4 digits, so the
/// merchant can recognise the payment.
model PawaPayDeposit {
  id                    String   @id // == PawaPay depositId (UUIDv4)
  businessId            String
  paymentRequestId      String   @unique
  status                String // INITIATED, ACCEPTED, COMPLETED, FAILED, REJECTED
  amountMinor           BigInt
  currencyCode          String
  provider              String // PawaPay provider code, e.g. AFRIMONEY_SLE
  payerPhoneLast4       String
  providerTransactionId String?
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime @default(now()) @db.Timestamptz()
  updatedAt             DateTime @updatedAt @db.Timestamptz()

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id])

  @@index([businessId])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Cross-cutting: audit, flags, consent, deletion
// ─────────────────────────────────────────────────────────────────────────

enum ActorType {
  MERCHANT
  ADMIN
  SYSTEM
}

/// One row per state-changing action, per Non-Negotiable Standard #8.
model AuditLog {
  id         String    @id @default(uuid())
  businessId String?
  actorType  ActorType
  actorId    String? // merchant message id, admin user id, or job name
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now()) @db.Timestamptz()

  business Business? @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
}

model FeatureFlag {
  key              String   @id
  description      String
  enabledByDefault Boolean  @default(false) // all flags default OFF in production per Non-Negotiable Standard #7
  createdAt        DateTime @default(now()) @db.Timestamptz()

  overrides BusinessFeatureFlag[]
}

model BusinessFeatureFlag {
  id         String  @id @default(uuid())
  businessId String
  flagKey    String
  enabled    Boolean

  business Business    @relation(fields: [businessId], references: [id])
  flag     FeatureFlag @relation(fields: [flagKey], references: [key])

  @@unique([businessId, flagKey])
  @@index([businessId])
}

enum ConsentType {
  ONBOARDING_TERMS
  DATA_PROCESSING
}

model ConsentLog {
  id          String      @id @default(uuid())
  businessId  String
  merchantId  String
  consentType ConsentType
  textVersion String // version identifier of the consent copy shown, for audit
  channel     String // e.g. "whatsapp"
  consentedAt DateTime    @default(now()) @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([businessId])
}

enum DeletionRequestorType {
  MERCHANT
  CUSTOMER_VIA_MERCHANT
  CUSTOMER_DIRECT
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

/// Because Transaction rows are append-only and cannot be deleted, the compliant resolution for a
/// customer-data deletion request is anonymizing Customer.name (see src/domain/deletion.ts), not
/// deleting financial history. See Phase 0 KQ5.
model DeletionRequest {
  id             String                @id @default(uuid())
  businessId     String
  customerId     String?
  requestorType  DeletionRequestorType
  description    String
  status         DeletionRequestStatus @default(PENDING)
  resolutionNote String?
  createdAt      DateTime              @default(now()) @db.Timestamptz()
  resolvedAt     DateTime?             @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Expansion Phase 1: reliable event delivery (docs/expansion/decisions.md P6)
// ─────────────────────────────────────────────────────────────────────────

enum OutboxStatus {
  PENDING
  /// Claimed by a worker; reclaimable after the visibility timeout if that worker died.
  PROCESSING
  PUBLISHED
  /// Gave up after the retry budget; needs a human (dead-letter replay in the admin console).
  DEAD
}

/// Transactional outbox: an event is inserted in the SAME database transaction as the business change that causes it,
/// and published asynchronously, so a crash can neither lose the event nor publish one for a change that rolled back.
/// `dedupeKey` makes enqueueing idempotent (the same business effect is never queued twice).
model OutboxEvent {
  id            String       @id @default(uuid())
  /// Tenant-owned events carry their business; platform events leave it null.
  businessId    String?
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  dedupeKey     String       @unique
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  /// Earliest time the next attempt may run (exponential backoff).
  availableAt   DateTime     @default(now()) @db.Timestamptz()
  claimedAt     DateTime?    @db.Timestamptz()
  lastError     String?
  publishedAt   DateTime?    @db.Timestamptz()
  createdAt     DateTime     @default(now()) @db.Timestamptz()

  @@index([status, availableAt])
  @@index([eventType, status])
}

enum InboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  DEAD
}

/// Durable inbox for provider callbacks (payments and others): persisted before the HTTP acknowledgement, deduplicated
/// on (provider, externalId), processed asynchronously. The WhatsApp inbox stays WebhookEvent.
model CallbackInbox {
  id                String      @id @default(uuid())
  provider          String
  /// The provider's own event/transaction id: the same callback delivered twice has the same one.
  externalId        String
  payload           Json
  /// True only when the provider's documented authentication was verified before the row was stored.
  signatureVerified Boolean     @default(false)
  status            InboxStatus @default(RECEIVED)
  attempts          Int         @default(0)
  availableAt       DateTime    @default(now()) @db.Timestamptz()
  claimedAt         DateTime?   @db.Timestamptz()
  lastError         String?
  receivedAt        DateTime    @default(now()) @db.Timestamptz()
  processedAt       DateTime?   @db.Timestamptz()

  @@unique([provider, externalId])
  @@index([status, availableAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Expansion Phase 1: platform admin console core (docs/expansion §18)
// ─────────────────────────────────────────────────────────────────────────

/// A platform admin's recorded, time-boxed reason for opening one merchant's books ("support access"). Append-only (a
/// database trigger rejects edits and deletes): it is the audit evidence of who looked at whose data and why.
model SupportAccess {
  id          String   @id @default(uuid())
  adminUserId String
  businessId  String
  reason      String
  openedAt    DateTime @default(now()) @db.Timestamptz()
  expiresAt   DateTime @db.Timestamptz()

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])
  business  Business  @relation(fields: [businessId], references: [id])

  @@index([adminUserId, businessId, expiresAt])
  @@index([businessId, openedAt])
}

/// Last time each long-running process reported in. Feeds the admin health view and the public /heartbeat endpoint an
/// external monitor (independent of Railway) can poll as a dead-man's switch.
model SystemHeartbeat {
  service    String   @id
  lastSeenAt DateTime @db.Timestamptz()
  meta       Json?
}

// ─────────────────────────────────────────────────────────────────────────
// Expansion Phase 2: catalog, price lists, stock, journals, daily close.
// Every table below is new and carries businessId (tenant scoping + RLS). Quantities are integers in the
// variant's BASE unit; money is integer minor units with the currency stated on the parent row.
// ─────────────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A thing the business sells or stocks. Variants carry SKU, unit and stock; the product is the shared name/description.
model Product {
  id          String        @id @default(uuid())
  businessId  String
  name        String
  description String?
  category    String?
  imageUrls   String[]
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @db.Timestamptz()

  business Business         @relation(fields: [businessId], references: [id])
  variants ProductVariant[]

  @@index([businessId, status])
}

model ProductVariant {
  id                String        @id @default(uuid())
  businessId        String
  productId         String
  sku               String
  barcode           String?
  name              String // e.g. "500 ml", "Red / L"; the product name is on Product
  baseUnit          String // smallest tracked quantum: piece, bottle, gram. Pack sizes convert to this explicitly.
  trackStock        Boolean       @default(true)
  lowStockThreshold Int? // in base units
  status            ProductStatus @default(DRAFT)
  inventoryItemId   String?       @unique // bridge to the legacy InventoryItem this variant adopted (Phase 2 adoption)
  createdAt         DateTime      @default(now()) @db.Timestamptz()
  updatedAt         DateTime      @updatedAt @db.Timestamptz()

  business      Business           @relation(fields: [businessId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  inventoryItem InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  aliases       VariantAlias[]
  packs         PackConversion[]
  priceRules    PriceRule[]
  balances      StockBalance[]
  movements     StockMovement[]
  reservations  StockReservation[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, productId])
}

/// Names a merchant (or a customer) actually uses for a variant: "sugar 1kg", "ndiyo". Normalized for lookup.
model VariantAlias {
  id              String   @id @default(uuid())
  businessId      String
  variantId       String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now()) @db.Timestamptz()

  business Business       @relation(fields: [businessId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([businessId, normalizedAlias])
  @@index([variantId])
}

/// A declared pack size: "1 carton = 24 pieces". Without a row here a carton is NOT convertible to pieces.
model PackConversion {
  id             String   @id @default(uuid())
  businessId     String
  variantId      String
  name           String // carton, bag, box, dozen
  normalizedName String
  baseQuantity   Int // how many base units one pack holds (>= 2, enforced by a CHECK)
  createdAt      DateTime @default(now()) @db.Timestamptz()

  business   Business       @relation(fields: [businessId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  priceRules PriceRule[]

  @@unique([variantId, normalizedName])
  @@index([businessId])
}

enum PriceListKind {
  RETAIL
  WHOLESALE
  CUSTOMER
}

enum PriceStatus {
  ACTIVE
  RETIRED
}

model PriceList {
  id           String        @id @default(uuid())
  businessId   String
  name         String
  kind         PriceListKind
  currencyCode String
  customerId   String? // CUSTOMER lists: the one customer these approved prices apply to
  status       PriceStatus   @default(ACTIVE)
  validFrom    DateTime?     @db.Timestamptz()
  validTo      DateTime?     @db.Timestamptz()
  createdAt    DateTime      @default(now()) @db.Timestamptz()

  business Business    @relation(fields: [businessId], references: [id])
  currency Currency    @relation(fields: [currencyCode], references: [code])
  customer Customer?   @relation(fields: [customerId], references: [id])
  rules    PriceRule[]

  @@index([businessId, kind, status])
}

/// One price point: "from minQuantity units (of this pack, or base unit when packConversionId is null) the unit price is X".
/// Several rules for the same variant/unit form quantity breaks.
model PriceRule {
  id               String      @id @default(uuid())
  businessId       String
  priceListId      String
  variantId        String
  packConversionId String?
  minQuantity      Int         @default(1)
  unitPriceMinor   BigInt
  status           PriceStatus @default(ACTIVE)
  validFrom        DateTime?   @db.Timestamptz()
  validTo          DateTime?   @db.Timestamptz()
  createdAt        DateTime    @default(now()) @db.Timestamptz()

  business       Business        @relation(fields: [businessId], references: [id])
  priceList      PriceList       @relation(fields: [priceListId], references: [id])
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  packConversion PackConversion? @relation(fields: [packConversionId], references: [id])

  @@index([priceListId, variantId])
  @@index([businessId])
}

enum StockMovementKind {
  OPENING_BALANCE // migrated/declared starting stock, labelled as such
  RECEIPT
  SALE_FULFILLMENT
  RETURN_RESTOCK
  COUNT_ADJUSTMENT
  SPOILAGE
  OWNER_WITHDRAWAL
  DAMAGE_QUARANTINE
  TRANSFER_DISPATCH
  TRANSFER_RECEIPT
  MANUAL_ADJUSTMENT
  LEGACY_MIRROR // mirrored from the legacy InventoryItem path
  REVERSAL
}

enum Provenance {
  MERCHANT_ENTERED
  DOCUMENT_SUPPORTED
  PROVIDER_CONFIRMED
  RECONCILED
  MIGRATED_OPENING
  SYSTEM_DERIVED
}

/// Append-only. The balance is the sum of these; a correction is a new REVERSAL/adjustment row.
model StockMovement {
  id                   String            @id @default(uuid())
  businessId           String
  shopId               String
  variantId            String
  kind                 StockMovementKind
  onHandDelta          Int               @default(0)
  damagedDelta         Int               @default(0)
  inTransitDelta       Int               @default(0)
  unitCostMinor        BigInt? // per base unit, when known (receipts, restocks); null = cost unknown
  costCurrency         String?
  costIncomplete       Boolean           @default(false) // a SALE_FULFILLMENT whose cost could not be fully determined
  costMinor            BigInt? // cost of the units that LEFT on-hand (sale, spoilage, withdrawal...), computed at posting time
  occurredAt           DateTime          @default(now()) @db.Timestamptz()
  createdAt            DateTime          @default(now()) @db.Timestamptz()
  provenance           Provenance        @default(MERCHANT_ENTERED)
  sourceType           String?
  sourceId             String?
  actorType            ActorType         @default(SYSTEM)
  actorId              String?
  note                 String?
  idempotencyKey       String?
  reversalOfMovementId String?           @unique

  business   Business       @relation(fields: [businessId], references: [id])
  shop       Shop           @relation(fields: [shopId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  reversalOf StockMovement? @relation("StockMovementReversal", fields: [reversalOfMovementId], references: [id])
  reversedBy StockMovement? @relation("StockMovementReversal")

  @@unique([businessId, idempotencyKey])
  @@index([businessId, variantId, createdAt])
  @@index([sourceType, sourceId])
}

/// Running balance per variant per shop. The conditional updates that touch it (see src/domain/stock) are what
/// stop two concurrent orders taking the last unit; stockReconcile compares it with the movement sums.
model StockBalance {
  id           String   @id @default(uuid())
  businessId   String
  shopId       String
  variantId    String
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  damaged      Int      @default(0)
  inTransit    Int      @default(0)
  avgCostMinor BigInt? // moving weighted average over COSTED units only; null until a costed receipt
  uncostedQty  Int      @default(0) // on-hand units that arrived without a cost
  costCurrency String?
  updatedAt    DateTime @updatedAt @db.Timestamptz()

  business Business       @relation(fields: [businessId], references: [id])
  shop     Shop           @relation(fields: [shopId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([shopId, variantId])
  @@index([businessId, variantId])
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model StockReservation {
  id             String                 @id @default(uuid())
  businessId     String
  shopId         String
  variantId      String
  quantity       Int
  status         StockReservationStatus @default(ACTIVE)
  expiresAt      DateTime               @db.Timestamptz()
  reference      String // what holds it: "order:<id>", "basket:<id>"
  idempotencyKey String
  createdAt      DateTime               @default(now()) @db.Timestamptz()
  settledAt      DateTime?              @db.Timestamptz()

  business Business       @relation(fields: [businessId], references: [id])
  shop     Shop           @relation(fields: [shopId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([businessId, variantId])
}

enum NegativeStockPolicy {
  ALLOW // a sale is never blocked by an estimate reaching zero (legacy behaviour, the default)
  BLOCK // reservations/fulfilments beyond available stock are refused unless an approver is named
}

model StockPolicy {
  id             String              @id @default(uuid())
  businessId     String              @unique
  negativeStock  NegativeStockPolicy @default(ALLOW)
  allowBackorder Boolean             @default(false)
  updatedAt      DateTime            @updatedAt @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id])
}

enum StockCountStatus {
  OPEN
  APPROVED
  CANCELLED
}

model StockCount {
  id         String           @id @default(uuid())
  businessId String
  shopId     String
  status     StockCountStatus @default(OPEN)
  note       String?
  openedBy   String?
  approvedBy String?
  createdAt  DateTime         @default(now()) @db.Timestamptz()
  approvedAt DateTime?        @db.Timestamptz()

  business Business         @relation(fields: [businessId], references: [id])
  shop     Shop             @relation(fields: [shopId], references: [id])
  lines    StockCountLine[]

  @@index([businessId, status])
}

model StockCountLine {
  id          String   @id @default(uuid())
  businessId  String
  countId     String
  variantId   String
  expectedQty Int // on-hand when the count was opened (snapshot)
  countedQty  Int
  discrepancy Int // countedQty - expectedQty
  reason      String? // required to approve a non-zero discrepancy
  createdAt   DateTime @default(now()) @db.Timestamptz()

  business Business   @relation(fields: [businessId], references: [id])
  count    StockCount @relation(fields: [countId], references: [id])

  @@unique([countId, variantId])
}

enum StockTransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id           String              @id @default(uuid())
  businessId   String
  fromShopId   String
  toShopId     String
  status       StockTransferStatus @default(DRAFT)
  note         String?
  createdAt    DateTime            @default(now()) @db.Timestamptz()
  dispatchedAt DateTime?           @db.Timestamptz()
  receivedAt   DateTime?           @db.Timestamptz()

  business Business            @relation(fields: [businessId], references: [id])
  fromShop Shop                @relation("TransferFrom", fields: [fromShopId], references: [id])
  toShop   Shop                @relation("TransferTo", fields: [toShopId], references: [id])
  lines    StockTransferLine[]

  @@index([businessId, status])
}

model StockTransferLine {
  id               String  @id @default(uuid())
  businessId       String
  transferId       String
  variantId        String
  quantitySent     Int
  quantityReceived Int?
  unitCostMinor    BigInt? // cost carried from the source shop at dispatch

  business Business      @relation(fields: [businessId], references: [id])
  transfer StockTransfer @relation(fields: [transferId], references: [id])

  @@unique([transferId, variantId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id         String      @id @default(uuid())
  businessId String
  code       String
  name       String
  type       AccountType
  systemKey  String? // stable key the posting rules use: CASH, MOBILE_MONEY, AR, ...
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @db.Timestamptz()

  business Business      @relation(fields: [businessId], references: [id])
  lines    JournalLine[]

  @@unique([businessId, code])
  @@unique([businessId, systemKey])
}

/// Append-only. Balanced per entry (deferred constraint trigger). One currency per entry.
model JournalEntry {
  id                String     @id @default(uuid())
  businessId        String
  currencyCode      String
  occurredAt        DateTime   @db.Timestamptz()
  postedAt          DateTime   @default(now()) @db.Timestamptz()
  kind              String // SALE, EXPENSE, STOCK_PURCHASE, DEBT_PAYMENT, REFUND, OWNER_WITHDRAWAL, FEE, SETTLEMENT, CASH_ADJUSTMENT, ...
  memo              String?
  sourceType        String?
  sourceId          String?
  provenance        Provenance @default(MERCHANT_ENTERED)
  evidenceRef       String?
  actorType         ActorType  @default(SYSTEM)
  actorId           String?
  idempotencyKey    String
  reversalOfEntryId String?    @unique

  business   Business      @relation(fields: [businessId], references: [id])
  currency   Currency      @relation(fields: [currencyCode], references: [code])
  lines      JournalLine[]
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfEntryId], references: [id])
  reversedBy JournalEntry? @relation("JournalReversal")

  @@unique([businessId, idempotencyKey])
  @@index([businessId, occurredAt])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id          String  @id @default(uuid())
  businessId  String
  entryId     String
  accountId   String
  debitMinor  BigInt  @default(0)
  creditMinor BigInt  @default(0)
  memo        String?

  business Business     @relation(fields: [businessId], references: [id])
  entry    JournalEntry @relation(fields: [entryId], references: [id])
  account  Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([businessId, accountId])
}

/// The end-of-day cash count for one business day. Append-only once written: a difference is explained by a
/// CASH_ADJUSTMENT journal entry, never by editing the row.
model DailyClose {
  id                String   @id @default(uuid())
  businessId        String
  businessDate      DateTime @db.Date
  currencyCode      String
  expectedCashMinor BigInt
  countedCashMinor  BigInt
  differenceMinor   BigInt
  summary           Json // snapshot of the day: sales by method, credit sales, collections, refunds, fees, wallet matching
  note              String?
  closedBy          String?
  closedAt          DateTime @default(now()) @db.Timestamptz()
  adjustmentEntryId String?

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, businessDate, currencyCode])
}
